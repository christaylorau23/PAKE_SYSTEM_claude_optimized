# TruffleHog Ignore File
# Patterns and paths to exclude from secret scanning

# Ignore common false positives
*.log
*.tmp
*.cache
*.pyc
__pycache__/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Ignore test data and fixtures
tests/fixtures/
tests/data/
test_data/
fixtures/
mock_data/

# Ignore documentation and examples
docs/
examples/
*.md
*.rst
*.txt

# Ignore build artifacts
build/
dist/
*.egg
*.whl

# Ignore environment files (these should be in .gitignore anyway)
.env
.env.local
.env.*.local
.venv/
venv/
mcp-env/

# Ignore node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore backup files
backups/
security_backups/
*.bak
*.backup

# Ignore generated files
generated/
auto-generated/

# Ignore specific file types that commonly contain false positives
*.json.bak
*.xml.bak
*.yaml.bak
*.yml.bak

# Ignore specific directories with known false positives
logs/
temp/
tmp/
cache/
# PAKE System - Development Docker Container
# Multi-stage build optimized for development with hot reload

# =============================================================================
# Stage 1: Base Dependencies - Install system and Python dependencies
# =============================================================================
FROM python:3.12-slim as base

# Set environment variables for development
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies for development
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    postgresql-client \
    redis-tools \
    vim \
    htop \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set working directory
WORKDIR /app

# Copy dependency files first for better layer caching
COPY requirements-core.txt requirements-phase7.txt ./

# Install Python dependencies with development tools
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-phase7.txt && \
    pip install --no-cache-dir \
        pytest-asyncio \
        pytest-mock \
        ipython \
        jupyter \
        black \
        ruff \
        mypy

# =============================================================================
# Stage 2: Development Runtime - Add user and application code
# =============================================================================
FROM base as development

# Create non-root user for development
RUN useradd --create-home --shell /bin/bash pake

# Create necessary directories with proper permissions
RUN mkdir -p logs cache data vault && \
    chown -R pake:pake /app && \
    chmod 700 /app/vault

# Switch to non-root user
USER pake

# Copy application code (will be overridden by volume in development)
COPY --chown=pake:pake . .

# Expose ports
EXPOSE 8000 8001

# Development command (overridden in docker-compose.dev.yml)
CMD ["python", "mcp_server_realtime.py"]

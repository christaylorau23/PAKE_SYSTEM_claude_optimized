# PAKE System Bridge Dockerfile - Multi-Stage Build
# Optimized for development and production with layer caching

# =============================================================================
# Stage 1: Dependencies - Install and cache dependencies
# =============================================================================
FROM node:22-alpine AS dependencies

# Install build dependencies for native modules
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    ca-certificates

WORKDIR /app

# Copy package files first for better layer caching
COPY src/bridge/package*.json ./

# Install dependencies
RUN npm ci --only=production && npm cache clean --force

# =============================================================================
# Stage 2: Development - Full development environment
# =============================================================================
FROM node:22-alpine AS development

# Install development dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    ca-certificates \
    curl

WORKDIR /app

# Copy package files
COPY src/bridge/package*.json ./

# Install all dependencies (including dev)
RUN npm ci && npm cache clean --force

# Create non-root user
RUN addgroup -g 1000 pake && adduser -D -s /bin/sh -u 1000 -G pake pake

# Copy application code
COPY --chown=pake:pake src/bridge/ .

# Set proper permissions
RUN chown -R pake:pake /app

# Switch to non-root user
USER pake

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"

# Start application
CMD ["npm", "start"]

# =============================================================================
# Stage 3: Production - Minimal runtime image
# =============================================================================
FROM node:22-alpine AS production

# Security labels
LABEL maintainer="PAKE System <christaylorau23@gmail.com>" \
      description="PAKE Bridge Service - Development/Production" \
      version="1.0.0" \
      security.hardened="true" \
      security.non-root="true"

# Environment variables
ENV NODE_ENV=production \
    PORT=3001

# Install only runtime dependencies
RUN apk add --no-cache \
    curl \
    ca-certificates \
    tzdata && \
    rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1000 pake && adduser -D -s /bin/sh -u 1000 -G pake pake

WORKDIR /app

# Copy production dependencies from dependencies stage
COPY --from=dependencies --chown=pake:pake /app/node_modules ./node_modules

# Copy application code
COPY --chown=pake:pake src/bridge/ .

# Create necessary directories
RUN mkdir -p /app/logs /app/cache && \
    chown -R pake:pake /app && \
    chmod -R 555 /app && \
    chmod 755 /app/logs /app/cache

# Switch to non-root user
USER pake

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3001/health || exit 1

# Start application
CMD ["npm", "start"]

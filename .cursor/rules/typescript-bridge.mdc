## 8. Security Best Practices

### CORS Configuration
**MUST**: Configure CORS properly with specific origins.

```typescript
// ✅ CORRECT - Specific CORS configuration
import cors from 'cors';

app.use(cors({
  origin: process.env.ALLOWED_ORIGINS?.split(',') || ['http://localhost:3000'],
  credentials: true,
  methods: ['GET', 'POST', 'PUT', 'DELETE'],
  allowedHeaders: ['Content-Type', 'Authorization']
}));

// ❌ WRONG - Wildcard CORS
app.use(cors({ origin: '*' }));  // Security risk!
```

### Input Validation
**MUST**: Validate all input data before processing.

```typescript
// ✅ CORRECT - Input validation
function validateNoteData(data: unknown): NoteData {
  if (typeof data !== 'object' || data === null) {
    throw new Error('Invalid note data: must be an object');
  }

  const note = data as Partial<NoteData>;

  if (!note.title || typeof note.title !== 'string') {
    throw new Error('Invalid note data: title is required');
  }

  if (!note.content || typeof note.content !== 'string') {
    throw new Error('Invalid note data: content is required');
  }

  return {
    title: note.title,
    content: note.content,
    tags: Array.isArray(note.tags) ? note.tags : [],
    type: note.type || 'note'
  };
}
```

## 9. Code Organization

### Module Structure
**MUST**: Follow clear module boundaries and single responsibility principle.

```typescript
// routes/notes.ts
import { Router } from 'express';

export const notesRouter = Router();

notesRouter.get('/', listNotes);
notesRouter.get('/:id', getNote);
notesRouter.post('/', createNote);
notesRouter.put('/:id', updateNote);
notesRouter.delete('/:id', deleteNote);

// main.ts
import { notesRouter } from './routes/notes';

app.use('/api/notes', notesRouter);
```

## 10. Testing

**MUST**: Write tests using Jest with TypeScript.

```typescript
// ✅ CORRECT - TypeScript tests with Jest
import request from 'supertest';
import { app } from '../obsidian_bridge';

describe('Notes API', () => {
  describe('POST /api/notes', () => {
    it('should create a new note with valid data', async () => {
      const noteData: NoteData = {
        title: 'Test Note',
        content: 'Test content',
        tags: ['test']
      };

      const response = await request(app)
        .post('/api/notes')
        .send(noteData)
        .expect(201);

      expect(response.body.success).toBe(true);
      expect(response.body.data.title).toBe('Test Note');
    });
  });
});
```

